<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Phiếu học tập số 1 đến 5</title>
<link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@600;800&family=Be+Vietnam+Pro:wght@400;600;800&family=Nunito:wght@500;700;800&display=swap" rel="stylesheet">
<style>

:root{--ink:#3b3340;--paper:#fffdf8;--ok:#2e9b5f;--bad:#e5484d;--k:1;--kp:1}
@media(min-width:1000px){:root{--k:1.25;--kp:1.15}}
@media(min-width:1400px){:root{--k:1.5;--kp:1.35}}
@media(min-width:1800px){:root{--k:1.7;--kp:1.5}}
html{font-size:clamp(16px,.9vw + 8px,28px)}
.tabs{--k:var(--kp)}
*{box-sizing:border-box}
html,body{margin:0}
body{font-family:'Nunito','Segoe UI',Arial,sans-serif;color:var(--ink);background:#f6f1e7;font-size:calc(var(--k) * 16px);line-height:1.5}
body.on3{line-height:normal}
#p45{--k:var(--kp);font-size:calc(var(--k) * 16px);padding:0 12px 40px}
#p12{--ink:#3a3844;--paper:#fffefb;--on:#33303d;font-size:1rem;padding:0 .75rem 2.5rem}
body.on12{background:#f8f3ec}
#s3{display:none}
#s3.active{display:block}
@media print{
  body,body.on3{background:#fff!important}
  .tabs,#p45 .bar,#p12 .bar{display:none}
  #s3{display:none!important}
  #p45,#p12{padding:0}
  #p45 .sheet,#p12 .sheet{display:block!important;box-shadow:none;page-break-after:always;border-radius:0;margin:0 auto}
  #p45 .sheet:last-child,#p12 .sheet:last-child{page-break-after:auto}
}

.tabs{max-width:calc(var(--k) * 1100px);margin:0 auto;padding:calc(var(--k) * 14px) calc(var(--k) * 12px);display:flex;gap:calc(var(--k) * 10px);justify-content:center;flex-wrap:wrap}
.tab{font:800 calc(var(--k) * 17px) 'Baloo 2','Nunito',sans-serif;border:3px solid;border-radius:999px;padding:calc(var(--k) * 6px) calc(var(--k) * 22px);cursor:pointer;background:#fff}
.tab.c{border-color:#ff9d7a;color:#b8481f}
.tab.v{border-color:#b79af0;color:#6a40b5}
.tab.c.on{background:#ff9d7a;color:#33303d}
.tab.v.on{background:#b79af0;color:#33303d}
.tab.o{border-color:#ff8c28;color:#b85a00}
.tab.y{border-color:#ffc933;color:#b37a00}
.tab.b{border-color:#4fa3ff;color:#1f5fb3}
.tab.o.on{background:#ff8c28;color:#2a1200}
.tab.y.on{background:#ffc933;color:#4a3300}
.tab.b.on{background:#4fa3ff;color:#fff}
#p12 .sheet{--c:#ff9d7a;--cd:#b8481f;--cl:#fff0e8;--cb:#ffd2bf;display:none;max-width:54rem;margin:0 auto;background:var(--paper);border:.19rem solid var(--c);border-radius:1.75rem;padding:1.4rem 1.5rem 1.75rem;box-shadow:0 .37rem 0 var(--cb)}
#p12 .sheet.p2{--c:#b79af0;--cd:#6a40b5;--cl:#f3edff;--cb:#dccfff}
#p12 .sheet.active{display:block}
#p12 h1{font:800 1.85rem 'Baloo 2','Nunito',sans-serif;margin:0;color:var(--cd);line-height:1.2}
#p12 .sub{margin:.1rem 0 .75rem;font-weight:700}
#p12 .who{display:flex;gap:.6rem;flex-wrap:wrap;margin-bottom:.4rem}
#p12 .who label{flex:1 1 12rem;font-weight:800;font-size:.88rem}
#p12 .who input{width:100%;margin-top:.1rem}
#p12 .q{background:var(--cl);border-radius:1.25rem;padding:.9rem 1rem;margin-top:1rem}
#p12 .q h2{font:800 1.2rem 'Baloo 2','Nunito',sans-serif;margin:0 0 .5rem;color:var(--cd);line-height:1.4}
#p12 .q h2 span{background:var(--c);color:var(--on);border-radius:999px;padding:.05rem .75rem;margin-right:.4rem;white-space:nowrap}
#p12 .q p{margin:.35rem 0}
#p12 input,#p12 select,#p12 textarea{font:600 .95rem 'Nunito',sans-serif;color:var(--ink);border:.125rem solid var(--cb);border-radius:.75rem;padding:.35rem .6rem;background:#fff;outline:none}
#p12 input:focus,#p12 select:focus,#p12 textarea:focus{border-color:var(--c);box-shadow:0 0 0 .19rem var(--cb)}
#p12 textarea{width:100%;min-height:4.6rem;resize:vertical}
#p12 .fill{line-height:2.7;background:#fff;border-radius:1rem;padding:.3rem .9rem;margin:.4rem 0}
#p12 .fill input.s{width:6.5rem;text-align:center}
#p12 .ok{border-color:var(--ok)!important;background:#eafaf0!important}
#p12 .bad{border-color:var(--bad)!important;background:#fff0f0!important}
#p12 .bank{background:#fff;border:.125rem dashed var(--c);border-radius:1.1rem;padding:.4rem .7rem .5rem;display:flex;flex-wrap:wrap;gap:.4rem;align-items:center;min-height:3rem}
#p12 .bank:before{content:"🧺 Từ gợi ý:";font-weight:800;color:var(--cd);font-size:.9rem;margin-right:.2rem}
#p12 .chip{background:var(--c);color:var(--on);font-weight:800;font-size:.92rem;border-radius:.8rem;padding:.25rem .75rem;cursor:grab;box-shadow:0 .19rem 0 rgba(0,0,0,.15);user-select:none}
#p12 .slot{display:inline-flex;align-items:center;justify-content:center;min-width:8.5rem;min-height:2.2rem;vertical-align:middle;border:.15rem dashed var(--c);border-radius:.8rem;background:var(--cl);padding:.1rem .3rem;font-size:.8rem;color:#8a7f90}
#p12 .slot:empty::before{content:"kéo từ vào đây"}
#p12 .slot .chip{box-shadow:none;font-size:.92rem}
#p12 .slot.over,#p12 .bank.over{background:var(--cb)}
#p12 .chip.sel{outline:.19rem solid var(--cd)}
#p12 .row{display:flex;align-items:center;justify-content:space-between;gap:.6rem;flex-wrap:wrap;background:#fff;border-radius:.9rem;padding:.4rem .75rem;margin:.4rem 0}
#p12 .row b{font-weight:800}
#p12 .row select{flex:1 1 15rem;max-width:100%}
#p12 .hint{display:none;margin-top:.55rem;background:#fff;border-left:.375rem solid var(--c);border-radius:.75rem;padding:.5rem .75rem;font-size:.92rem}
#p12 .show .hint{display:block}
#p12 .hinted{font-style:italic;color:#6a5f70}
#p12 .bar{display:flex;gap:.6rem;flex-wrap:wrap;align-items:center;margin-top:.8rem}
#p12 .btn{font:800 1rem 'Baloo 2','Nunito',sans-serif;border:0;border-radius:999px;padding:.4rem 1.1rem;cursor:pointer;box-shadow:0 .25rem 0 rgba(0,0,0,.16);color:var(--on);background:var(--c)}
#p12 .btn.alt{background:#fff;color:var(--cd);border:.125rem solid var(--c)}
#p12 .btn:active{transform:translateY(2px);box-shadow:0 .1rem 0 rgba(0,0,0,.16)}
#p12 .msg{font:800 1.05rem 'Baloo 2','Nunito',sans-serif;color:var(--cd)}
#p12 .ok{border-color:#2e9b5f!important;background:#e6f7ec!important}
#p12 .bad{border-color:#e5484d!important;background:#ffecec!important}
#p12 input.ok,#p12 select.ok,#p12 textarea.ok{color:#1b6b40}
#p12 input.bad,#p12 select.bad,#p12 textarea.bad{color:#b3262b}
#p12 .slot.ok,#p12 .slot.bad{border-style:solid}
#p12 .sheet .slot.ok .chip{background:#2e9b5f;color:#fff}
#p12 .sheet .slot.bad .chip{background:#e5484d;color:#fff}
#p12 .sheet .pills.ok button.on{background:#2e9b5f;border-color:#2e9b5f;color:#fff}
#p12 .sheet .pills.bad button.on{background:#e5484d;border-color:#e5484d;color:#fff}
#p12 .msg.good{color:#2e9b5f}
#p12 .msg.wrong{color:#e5484d}
@media(max-width:600px){#p12 .sheet{padding:1rem .75rem}
#p12 h1{font-size:1.5rem}
#p12 .slot{min-width:6.5rem}}
#p45 .sheet{--c:#ffc933;--cd:#b37a00;--cl:#fff4cc;--cb:#ffe58f;display:none;max-width:calc(var(--k) * 860px);margin:0 auto;background:var(--paper);border:3px solid var(--c);border-radius:28px;padding:calc(var(--k) * 22px) calc(var(--k) * 24px) calc(var(--k) * 28px);box-shadow:0 6px 0 var(--cb)}
#p45 .sheet.blue{--c:#4fa3ff;--cd:#1f5fb3;--cl:#e3f1ff;--cb:#b9dbff}
#p45 .sheet.active{display:block}
#p45 h1{font:800 calc(var(--k) * 30px) 'Baloo 2','Nunito',sans-serif;margin:0;color:var(--cd);line-height:1.2}
#p45 .sub{margin:calc(var(--k) * 2px) 0 calc(var(--k) * 12px);font-weight:700}
#p45 .who{display:flex;gap:calc(var(--k) * 10px);flex-wrap:wrap;margin-bottom:6px}
#p45 .who label{flex:1 1 200px;font-weight:800;font-size:calc(var(--k) * 14px)}
#p45 .who input{width:100%;margin-top:2px}
#p45 .q{background:var(--cl);border-radius:20px;padding:calc(var(--k) * 14px) calc(var(--k) * 16px);margin-top:16px}
#p45 .q h2{font:800 calc(var(--k) * 19px) 'Baloo 2','Nunito',sans-serif;margin:0 0 calc(var(--k) * 8px);color:var(--cd)}
#p45 .q h2 span{background:var(--c);color:#3a2a00;border-radius:999px;padding:calc(var(--k) * 1px) calc(var(--k) * 12px);margin-right:6px}
#p45 .blue .q h2 span{color:#fff}
#p45 .row{display:flex;align-items:center;justify-content:space-between;gap:calc(var(--k) * 10px);flex-wrap:wrap;background:#fff;border-radius:14px;padding:calc(var(--k) * 7px) calc(var(--k) * 12px);margin:calc(var(--k) * 6px) 0;border:2px solid transparent}
#p45 .row>b{font-weight:800}
#p45 input,#p45 select,#p45 textarea{font:600 calc(var(--k) * 15px) 'Nunito',sans-serif;color:var(--ink);border:2px solid var(--cb);border-radius:12px;padding:calc(var(--k) * 6px) calc(var(--k) * 10px);background:#fff;outline:none}
#p45 input:focus,#p45 select:focus,#p45 textarea:focus,#p45 .pills button:focus-visible{border-color:var(--c);box-shadow:0 0 0 3px var(--cb)}
#p45 textarea{width:100%;min-height:calc(var(--k) * 74px);resize:vertical}
#p45 .pills{display:inline-flex;gap:calc(var(--k) * 6px);padding:calc(var(--k) * 2px);border-radius:999px;border:2px solid transparent}
#p45 .pills button{font:700 calc(var(--k) * 14px) 'Nunito',sans-serif;border:2px solid var(--cb);background:#fff;color:var(--ink);border-radius:999px;padding:calc(var(--k) * 3px) calc(var(--k) * 14px);cursor:pointer}
#p45 .pills button.on{background:var(--c);border-color:var(--c);color:#3a2a00;font-weight:800}
#p45 .blue .pills button.on{color:#fff}
#p45 .ok{border-color:var(--ok)!important;background:#eafaf0!important}
#p45 .bad{border-color:var(--bad)!important;background:#fff0f0!important}
#p45 .fill{line-height:2.2}
#p45 .fill input{width:calc(var(--k) * 110px);text-align:center}
#p45 .legend{display:grid;grid-template-columns:1fr 1fr;gap:calc(var(--k) * 6px);margin-bottom:8px;font-weight:700;font-size:calc(var(--k) * 14px)}
#p45 .legend div{background:#fff;border-radius:12px;padding:calc(var(--k) * 6px) calc(var(--k) * 10px)}
#p45 .legend b{color:var(--cd)}
#p45 .hint{display:none;margin-top:8px;background:#fff;border-left:6px solid var(--c);border-radius:12px;padding:calc(var(--k) * 8px) calc(var(--k) * 12px);font-size:calc(var(--k) * 14.5px)}
#p45 .show .hint{display:block}
#p45 .hinted{font-style:italic;color:#6a5f70}
#p45 .bar{margin-top:14px;display:flex;gap:calc(var(--k) * 10px);flex-wrap:wrap;align-items:center;justify-content:center}
#p45 .btn{font:800 calc(var(--k) * 16px) 'Baloo 2','Nunito',sans-serif;border:0;border-radius:999px;padding:calc(var(--k) * 8px) calc(var(--k) * 20px);cursor:pointer;box-shadow:0 4px 0 rgba(0,0,0,.18);color:#3a2a00;background:var(--c)}
#p45 .blue .btn{color:#fff}
#p45 .btn.alt{background:#fff;color:var(--cd);border:2px solid var(--c)}
#p45 .btn:active{transform:translateY(2px);box-shadow:0 2px 0 rgba(0,0,0,.18)}
#p45 .msg{font:800 calc(var(--k) * 17px) 'Baloo 2','Nunito',sans-serif;color:var(--cd);min-width:calc(var(--k) * 140px);text-align:center}
#p45 .cols2{display:grid;grid-template-columns:1fr 1fr;gap:calc(var(--k) * 10px)}
#p45 .match{display:grid;grid-template-columns:1.1fr 1fr;gap:calc(var(--k) * 14px);align-items:start}
#p45 .mrow{display:flex;align-items:center;justify-content:space-between;gap:calc(var(--k) * 10px);background:#fff;border-radius:14px;padding:calc(var(--k) * 8px) calc(var(--k) * 10px);margin:calc(var(--k) * 6px) 0}
#p45 .slot{flex:0 0 58%;min-height:calc(var(--k) * 54px);border:2.5px dashed var(--c);border-radius:14px;background:var(--cl);display:flex;align-items:center;justify-content:center;padding:calc(var(--k) * 4px);font-size:calc(var(--k) * 13px);color:#7a6f80;text-align:center}
#p45 .slot:empty::before{content:"Kéo ứng dụng vào đây"}
#p45 .slot.over,#p45 .bank.over{background:var(--cb)}
#p45 .bank{background:#fff;border:2px solid var(--cb);border-radius:18px;padding:calc(var(--k) * 8px) calc(var(--k) * 10px);min-height:calc(var(--k) * 120px)}
#p45 .chip{background:var(--c);color:#3a2a00;font-weight:800;font-size:calc(var(--k) * 14px);line-height:1.35;border-radius:14px;padding:calc(var(--k) * 8px) calc(var(--k) * 12px);margin:calc(var(--k) * 6px) 0;cursor:grab;box-shadow:0 3px 0 rgba(0,0,0,.18);user-select:none;width:100%}
#p45 .slot .chip{margin:0;box-shadow:none}
#p45 .blue .chip{color:#fff}
#p45 .chip.sel{outline:3px solid var(--cd)}
#p45 .qnote{margin:0 0 calc(var(--k) * 8px);font-weight:700;font-size:calc(var(--k) * 14.5px);color:#6a5f70}
#p45 .row.j{display:grid;grid-template-columns:minmax(0,1.25fr) auto minmax(0,1.3fr);gap:calc(var(--k) * 12px);align-items:center}
#p45 .row.j input{width:100%;border-style:dashed;min-height:calc(var(--k) * 40px)}
@media(max-width:700px){#p45 .row.j{grid-template-columns:1fr}}
@media(max-width:600px){#p45 .match{grid-template-columns:1fr}
#p45 .slot{flex-basis:55%}
#p45 .sheet{padding:calc(var(--k) * 16px) calc(var(--k) * 12px)}
#p45 .legend,#p45 .cols2{grid-template-columns:1fr}
#p45 h1{font-size:calc(var(--k) * 24px)}}
@media(prefers-reduced-motion:reduce){#p45 *{transition:none!important}}
body.on3{
  --bg: #eef2ff;
  --glow: rgba(255, 140, 40, .18);
  --surface: #ffffff;
  --line: rgba(18, 22, 56, .14);
  --text: #121638;
  --muted: #4b5080;
  --accent: #ff8c28;
  --accent-ink: #1d0f06;
  --slot-line: #d9640a;
  --slot-bg: rgba(255, 140, 40, .08);
  --slot-over: rgba(255, 140, 40, .22);
  --bank-bg: #ffffff;
  --ok: #1fa85a;
  --ok-ink: #ffffff;
  --bad: #d93a4a;
  --bad-ink: #ffffff}
@media (prefers-color-scheme: dark){body.on3{
    --bg: #0a0e2a;
    --glow: rgba(255, 140, 40, .16);
    --surface: rgba(255, 255, 255, .05);
    --line: rgba(255, 255, 255, .14);
    --text: #f5f2ff;
    --muted: #b9b4dc;
    --slot-line: #ffb23e;
    --slot-bg: rgba(255, 178, 62, .07);
    --slot-over: rgba(255, 178, 62, .24);
    --bank-bg: #141945;
    --ok: #3ddc84;
    --ok-ink: #052212;
    --bad: #ff5d6c;
    --bad-ink: #2a0509;
  }}
body.on3{
  margin: 0;
  min-height: 100vh;
  background-color: var(--bg);
  background-image: radial-gradient(900px 420px at 85% -80px, var(--glow), transparent 70%);
  background-repeat: no-repeat;
  color: var(--text);
  font-family: "Be Vietnam Pro", system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  -webkit-text-size-adjust: 100%}
#s3 .wrap{ max-width: calc(var(--k) * 980px); margin: 0 auto; padding: calc(var(--k) * 34px) calc(var(--k) * 20px) calc(var(--k) * 70px)}
#s3 h1{ margin: 0; font-size: clamp(calc(var(--k) * 28px), 5vw, calc(var(--k) * 38px)); line-height: 1.12; font-weight: 800; letter-spacing: -.01em}
#s3 .hint{ margin: calc(var(--k) * 10px) 0 0; font-size: calc(var(--k) * 17px); color: var(--muted); font-style: italic}
#s3 .how{ margin: calc(var(--k) * 14px) 0 0; font-size: calc(var(--k) * 16px); line-height: 1.6; max-width: 66ch}
#s3 .scorebar{
  position: sticky;
  top: env(safe-area-inset-top, 0px);
  z-index: 30;
  display: flex;
  align-items: center;
  gap: calc(var(--k) * 16px);
  margin: calc(var(--k) * 22px) 0 0;
  padding: calc(var(--k) * 12px) calc(var(--k) * 18px);
  background: var(--bank-bg);
  border: 1.5px solid var(--line);
  border-radius: 16px;
  box-shadow: 0 8px 22px rgba(0, 0, 0, .16)}
#s3 .sb-text{ display: flex; flex-direction: column; gap: calc(var(--k) * 2px); min-width: calc(var(--k) * 150px)}
#s3 .sb-text strong{ font-size: calc(var(--k) * 18px)}
#s3 .sb-text span{ font-size: calc(var(--k) * 13px); color: var(--muted)}
#s3 .sb-bar{ flex: 1; height: calc(var(--k) * 10px); border-radius: 99px; background: var(--line); overflow: hidden}
#s3 .sb-bar i{ display: block; height: 100%; width: 0; background: var(--ok); transition: width .4s}
#s3 .card{
  margin: calc(var(--k) * 22px) 0 0;
  padding: calc(var(--k) * 22px) calc(var(--k) * 24px) calc(var(--k) * 24px);
  background: var(--surface);
  border: 1.5px solid var(--line);
  border-radius: 22px}
#s3 .q-head{ display: flex; align-items: flex-start; gap: calc(var(--k) * 14px); margin-bottom: 16px}
#s3 .q-badge{
  flex: none;
  padding: calc(var(--k) * 6px) calc(var(--k) * 15px);
  border-radius: 999px;
  background: var(--accent);
  color: var(--accent-ink);
  font-weight: 800;
  font-size: calc(var(--k) * 16px);
  white-space: nowrap}
#s3 .q-prompt{ margin: 0; font-size: calc(var(--k) * 19px); font-weight: 600; line-height: 1.5}
#s3 .q-sub{ margin: 0 0 calc(var(--k) * 14px); font-size: calc(var(--k) * 15px); color: var(--muted)}
#s3 .bank-wrap{
  padding: calc(var(--k) * 12px) calc(var(--k) * 14px) calc(var(--k) * 14px);
  background: var(--bank-bg);
  border: 1.5px solid var(--line);
  border-radius: 18px}
#s3 .bank-wrap.over{ outline: 3px dashed var(--slot-line); outline-offset: 3px}
#s3 .bank-label{ margin: 0 calc(var(--k) * 2px) calc(var(--k) * 10px); font-size: calc(var(--k) * 14px); font-weight: 600; color: var(--muted)}
#s3 .bank{ display: flex; flex-wrap: wrap; gap: calc(var(--k) * 10px); min-height: calc(var(--k) * 46px)}
#s3 .bank.stack{ flex-direction: column; flex-wrap: nowrap; gap: calc(var(--k) * 8px)}
#s3 .chip{
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: calc(var(--k) * 8px) calc(var(--k) * 18px);
  border-radius: 999px;
  background: var(--accent);
  color: var(--accent-ink);
  font-family: inherit;
  font-size: calc(var(--k) * 17px);
  font-weight: 600;
  line-height: 1.2;
  white-space: nowrap;
  cursor: grab;
  user-select: none;
  -webkit-user-select: none;
  touch-action: none;
  box-shadow: 0 3px 0 rgba(0, 0, 0, .28)}
#s3 .chip.num{ width: calc(var(--k) * 42px); height: calc(var(--k) * 42px); padding: 0; font-size: calc(var(--k) * 20px); font-weight: 800}
#s3 .chip.wide{
  width: 100%;
  justify-content: flex-start;
  padding: calc(var(--k) * 10px) calc(var(--k) * 16px);
  border-radius: 14px;
  white-space: normal;
  text-align: left;
  font-size: calc(var(--k) * 16px);
  line-height: 1.35}
#s3 .chip.selected{ outline: 3px solid var(--text); outline-offset: 2px}
#s3 .chip.dragging{ opacity: .25}
#s3 .chip.ghost{
  position: fixed;
  left: 0; top: 0;
  z-index: 1000;
  margin: 0;
  pointer-events: none;
  transform: scale(1.05) rotate(-1.5deg);
  box-shadow: 0 14px 28px rgba(0, 0, 0, .4);
  cursor: grabbing}
#s3 .chip.locked{ cursor: default; box-shadow: none}
#s3 .slot{
  display: inline-flex;
  vertical-align: middle;
  align-items: center;
  justify-content: center;
  min-width: calc(var(--k) * 140px);
  min-height: calc(var(--k) * 46px);
  margin: 0 calc(var(--k) * 6px);
  padding: calc(var(--k) * 2px);
  border: 2.5px dashed var(--slot-line);
