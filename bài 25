<script>
(function(){

const BAR='<div class="bar"><button class="btn" data-act="check">✅ Kiểm tra</button><button class="btn alt" data-act="reset">🔄 Làm lại</button><button class="btn alt" data-act="reveal">💡 Xem đáp án</button><span class="msg"></span></div>';
document.querySelectorAll('#p12 .q').forEach(q=>q.insertAdjacentHTML('beforeend',BAR));
const norm=s=>(s||'').toLowerCase().replace(/\s+/g,' ').trim();
const isS=el=>el.classList.contains('slot');
const val=el=>isS(el)?((el.querySelector('.chip')||{dataset:{}}).dataset.v||''):el.value;
const answers=el=>el.dataset.ans.split('|');
function place(slot,chip){
  const bank=chip.closest('.q').querySelector('.bank'),old=slot.querySelector('.chip');
  if(old&&old!==chip)bank.appendChild(old);
  slot.appendChild(chip);chip.classList.remove('sel');slot.classList.remove('ok','bad');
}
function setv(el,v){
  if(isS(el)){const c=[...el.closest('.q').querySelectorAll('.chip')].find(x=>x.dataset.v===v);if(c)place(el,c)}
  else el.value=v;
}
function correct(el){
  const v=norm(val(el));if(!v)return false;
  const a=answers(el).map(norm);
  return el.tagName==='INPUT'?a.includes(v):a.includes(v);
}
const clearMarks=q=>q.querySelectorAll('.ok,.bad').forEach(e=>e.classList.remove('ok','bad'));
let drag=null;
document.addEventListener('dragstart',e=>{drag=e.target.closest&&e.target.closest('#p12 .chip');if(drag)e.dataTransfer.setData('text/plain',drag.dataset.v)});
document.addEventListener('dragover',e=>{const t=e.target.closest&&e.target.closest('#p12 .slot,#p12 .bank');if(t&&drag){e.preventDefault();t.classList.add('over')}});
document.addEventListener('dragleave',e=>{const t=e.target.closest&&e.target.closest('#p12 .slot,#p12 .bank');if(t)t.classList.remove('over')});
document.addEventListener('drop',e=>{
  const t=e.target.closest&&e.target.closest('#p12 .slot,#p12 .bank');if(!t||!drag)return;
  e.preventDefault();t.classList.remove('over');
  if(drag.closest('.q')!==t.closest('.q'))return;
  if(isS(t))place(t,drag);else t.appendChild(drag);
});
document.addEventListener('dragend',()=>{drag=null;document.querySelectorAll('#p12 .over').forEach(x=>x.classList.remove('over'))});
document.addEventListener('click',e=>{
  if(!e.target.closest('#p12'))return;
  const sel=document.querySelector('#p12 .chip.sel'),slot=e.target.closest('.slot');
  if(slot&&sel&&sel.closest('.q')===slot.closest('.q')){place(slot,sel);return}
  const chip=e.target.closest('.chip');
  if(chip){
    if(isS(chip.parentNode)){chip.parentNode.classList.remove('ok','bad');chip.closest('.q').querySelector('.bank').appendChild(chip)}
    else{const was=chip.classList.contains('sel');document.querySelectorAll('.chip.sel').forEach(c=>c.classList.remove('sel'));if(!was)chip.classList.add('sel')}
    return;
  }
  const bank=e.target.closest('.bank');
  if(bank&&sel&&sel.closest('.q')===bank.closest('.q')){bank.appendChild(sel);sel.classList.remove('sel');return}
  const b=e.target.closest('[data-act]');if(!b)return;
  const q=b.closest('.q'),msg=q.querySelector('.msg'),items=[...q.querySelectorAll('[data-ans]')];msg.className='msg';
  if(b.dataset.act==='check'){
    clearMarks(q);
    if(!items.length){msg.textContent='Câu tự luận – viết xong rồi bấm “Xem đáp án” để so sánh nhé ✍️';return}
    let n=0;items.forEach(el=>{const ok=correct(el);if(ok)n++;el.classList.add(ok?'ok':'bad')});
    msg.textContent=n===items.length?`🎉 Chính xác ${n}/${items.length}!`:`Đúng ${n}/${items.length} – thử lại nhé 💪`;msg.classList.add(n===items.length?'good':'wrong');
  }
  if(b.dataset.act==='reveal'){
    clearMarks(q);
    items.forEach(el=>setv(el,el.dataset.rev||answers(el)[0]));
    q.classList.add('show');
    msg.textContent='Em so sánh với bài làm của mình nhé ✨';
  }
  if(b.dataset.act==='reset'){
    clearMarks(q);
    q.querySelectorAll('select,textarea,input').forEach(x=>{x.value='';x.classList.remove('hinted')});
    const bank=q.querySelector('.bank');
    if(bank)q.querySelectorAll('.chip').forEach(c=>{c.classList.remove('sel');bank.appendChild(c)});
    q.classList.remove('show');msg.textContent='';
  }
});
document.addEventListener('input',e=>{e.target.classList.remove('hinted','ok','bad')});

})();
</script>
<script>

(function () {
  'use strict';

  var TOTAL = 14;
  var groups = {};
  var order = [];
  var selected = null;
  var drag = null;
  var q9 = {};

  /* ---------- tiện ích ---------- */
  function el(tag, cls, text) {
    var e = document.createElement(tag);
    if (cls) e.className = cls;
    if (text != null) e.textContent = text;
    return e;
  }
  function shuffle(a) {
    for (var i = a.length - 1; i > 0; i--) {
      var j = Math.floor(Math.random() * (i + 1));
      var t = a[i]; a[i] = a[j]; a[j] = t;
    }
    return a;
  }
  function btn(label, cls) {
    var b = el('button', 'btn' + (cls ? ' ' + cls : ''), label);
    b.type = 'button';
    return b;
  }

  /* ---------- nhóm kéo thả ---------- */
  function newGroup(id, bankWrap, bank, answers) {
    var g = { id: id, bankWrap: bankWrap, bank: bank, answers: answers, slots: [], chips: [], correct: 0, resEl: null };
    bankWrap.dataset.group = id;
    bank.dataset.group = id;
    groups[id] = g;
    order.push(id);
    return g;
  }
  function addSlot(g, s) {
    s.dataset.group = g.id;
    g.slots.push(s);
    s.addEventListener('click', function () {
      if (selected && selected.dataset.group === g.id && !slotChip(s)) place(selected, s);
    });
  }
  function addChip(g, value, text, cls) {
    var c = el('span', 'chip' + (cls ? ' ' + cls : ''), text);
    c.dataset.value = value;
    c.dataset.group = g.id;
    g.chips.push(c);
    return c;
  }
  function bankBlock(label, bankCls) {
    var wrap = el('div', 'bank-wrap');
    wrap.appendChild(el('div', 'bank-label', label));
    var bank = el('div', 'bank' + (bankCls ? ' ' + bankCls : ''));
    wrap.appendChild(bank);
    return { wrap: wrap, bank: bank };
  }
  function fillBank(g) {
    shuffle(g.chips.slice()).forEach(function (c) { g.bank.appendChild(c); });
  }
  function section(badge, prompt) {
    var card = el('section', 'card');
    var head = el('div', 'q-head');
    head.appendChild(el('span', 'q-badge', badge));
    head.appendChild(el('p', 'q-prompt', prompt));
    card.appendChild(head);
    return card;
  }

  function slotChip(s) { return s.querySelector('.chip'); }
  function inSlot(c) { return !!(c.parentElement && c.parentElement.classList.contains('slot')); }
  function clearMarks(s) { s.classList.remove('correct', 'wrong'); }
  function clearRes(g) { if (g.resEl) { g.resEl.className = 'res'; g.resEl.textContent = ''; } }
  function setRes(g, kind, text) { g.resEl.className = 'res ' + kind; g.resEl.textContent = text; }
  function deselect() { if (selected) { selected.classList.remove('selected'); selected = null; } }
  function select(c) { deselect(); selected = c; c.classList.add('selected'); }

  function updateScore() {
    var sum = 0;
    order.forEach(function (id) { sum += groups[id].correct; });
    document.getElementById('scoreText').textContent = 'Đúng ' + sum + '/' + TOTAL;
    document.getElementById('scoreFill').style.width = (sum / TOTAL * 100) + '%';
  }

  function toBank(c) {
    var g = groups[c.dataset.group];
    var from = c.parentElement;
    g.bank.appendChild(c);
    if (from && from.classList.contains('slot')) clearMarks(from);
  }
  function place(c, slot) {
    if (c.dataset.group !== slot.dataset.group) return;
    var g = groups[c.dataset.group];
    var old = slotChip(slot);
    if (old && old !== c) {
      if (old.classList.contains('locked')) return;
      toBank(old);
    }
    var from = c.parentElement;
    slot.appendChild(c);
    if (from && from !== slot && from.classList.contains('slot')) clearMarks(from);
    clearMarks(slot);
    deselect();
    clearRes(g);
  }

  /* ---------- nút từng câu ---------- */
  function checkGroup(g) {
    deselect();
    var ok = 0;
    g.slots.forEach(function (s, i) {
      clearMarks(s);
      void s.offsetWidth;
      var c = slotChip(s);
      if (c && c.dataset.value === g.answers[i]) {
        s.classList.add('correct');
        c.classList.add('locked');
        ok++;
      } else {
        s.classList.add('wrong');
      }
    });
    g.correct = ok;
    var n = g.slots.length;
    if (ok === n) setRes(g, 'good', 'Chính xác! ' + ok + '/' + n);
    else setRes(g, 'try', 'Đúng ' + ok + '/' + n + '. Sửa các ô màu đỏ rồi bấm Kiểm tra lại.');
    updateScore();
    return ok;
  }
  function resetGroup(g) {
    deselect();
    g.chips.forEach(function (c) { c.classList.remove('locked'); });
    g.slots.forEach(clearMarks);
    fillBank(g);
    g.correct = 0;
    clearRes(g);
    updateScore();
  }
  function revealGroup(g) {
    deselect();
    g.chips.forEach(function (c) { c.classList.remove('locked'); });
    g.slots.forEach(clearMarks);
    g.answers.forEach(function (ans, i) {
      var c = g.chips.filter(function (x) { return x.dataset.value === ans; })[0];
      place(c, g.slots[i]);
    });
    g.slots.forEach(function (s) {
      s.classList.add('correct');
      slotChip(s).classList.add('locked');
    });
    g.correct = 0;
    setRes(g, 'good', 'Đây là đáp án đúng. Bấm Làm lại để tự thử (xem đáp án thì không được tính điểm).');
    updateScore();
  }
  function actions(g, card) {
    var row = el('div', 'actions');
    var bCheck = btn('Kiểm tra', 'primary');
    var bReset = btn('Làm lại');
    var bReveal = btn('Xem đáp án');
    var res = el('span', 'res');
    res.setAttribute('role', 'status');
    res.setAttribute('aria-live', 'polite');
    g.resEl = res;
    bCheck.addEventListener('click', function () { checkGroup(g); });
    bReset.addEventListener('click', function () { resetGroup(g); });
    bReveal.addEventListener('click', function () { revealGroup(g); });
    row.appendChild(bCheck); row.appendChild(bReset); row.appendChild(bReveal); row.appendChild(res);
    card.appendChild(row);
  }

  /* ---------- dựng các câu ---------- */
  var app = document.getElementById('app');

  // Câu 8
  (function () {
    var items = [
      { text: 'Vận chuyển dầu thô đến nhà máy lọc dầu bằng ống dẫn hoặc tàu chở dầu.', answer: '3' },
      { text: 'Xử lí dầu thô ở nhà máy lọc dầu, chủ yếu bằng phương pháp chưng cất, để thu nhiều sản phẩm khác nhau.', answer: '4' },
      { text: 'Khoan, thu dầu và khí.', answer: '1' },
      { text: 'Loại bỏ tạp chất để thu được dầu thô.', answer: '2' }
    ];
    var card = section('Câu 8', 'Đánh số 1 → 4 để sắp xếp các giai đoạn khai thác, chế biến theo đúng thứ tự.');
    var bb = bankBlock('Kéo số vào ô trống ở đầu mỗi dòng', '');
    var g = newGroup('q8', bb.wrap, bb.bank, items.map(function (i) { return i.answer; }));
    ['1', '2', '3', '4'].forEach(function (n) { addChip(g, n, n, 'num'); });
    card.appendChild(bb.wrap);
    var list = el('div', 'order-list');
    items.forEach(function (it) {
      var row = el('div', 'order-row');
      var s = el('span', 'slot round');
      addSlot(g, s);
      row.appendChild(s);
      row.appendChild(el('p', null, it.text));
      list.appendChild(row);
    });
    card.appendChild(list);
    actions(g, card);
    app.appendChild(card);
    fillBank(g);
  })();

  // Câu 9
  (function () {
    var card = section('Câu 9', 'Vì sao chưng cất dầu thô lại thu được nhiều sản phẩm khác nhau?');
    var ta = document.createElement('textarea');
    ta.placeholder = 'Viết câu trả lời của em ở đây…';
    ta.setAttribute('aria-label', 'Câu trả lời câu 9');
    card.appendChild(ta);

    var model = el('div', 'model');
    var b = el('b', null, 'Đáp án gợi ý');
    var p = el('p', null, 'Vì dầu thô là hỗn hợp của nhiều hydrocarbon có nhiệt độ sôi khác nhau. Khi chưng cất, mỗi thành phần bay hơi và ngưng tụ ở một khoảng nhiệt độ riêng, nên tách được thành nhiều sản phẩm (phân đoạn) khác nhau như khí hóa lỏng, xăng, dầu hỏa, dầu diesel,…');
    var kwrow = el('div', 'kwrow');
    model.appendChild(b); model.appendChild(p); model.appendChild(kwrow);
    card.appendChild(model);

    var KW = [
      { label: 'hỗn hợp', re: /hỗn hợp/ },
      { label: 'hydrocarbon', re: /hydrocarbon|hiđrocacbon|hidrocacbon/ },
      { label: 'nhiệt độ sôi', re: /nhiệt độ sôi/ }
    ];
    var row = el('div', 'actions');
    var bShow = btn('Xem đáp án mẫu', 'primary');
    var bClear = btn('Xóa bài viết');
    bShow.addEventListener('click', function () {
      var txt = ta.value.normalize('NFC').toLowerCase();
      kwrow.innerHTML = '';
      kwrow.appendChild(el('span', null, txt.trim() ? 'Từ khóa trong đáp án mẫu:' : 'Hãy thử viết câu trả lời của em trước, rồi so sánh với từ khóa:'));
      KW.forEach(function (k) {
        var hit = txt.trim() && k.re.test(txt);
        kwrow.appendChild(el('span', 'kw ' + (hit ? 'hit' : 'miss'), k.label));
      });
      model.classList.add('show');
    });
    bClear.addEventListener('click', function () { ta.value = ''; model.classList.remove('show'); });
    row.appendChild(bShow); row.appendChild(bClear);
    card.appendChild(row);
    app.appendChild(card);
    q9.ta = ta; q9.model = model;
  })();

  // Câu 10
  (function () {
    var A = [
      { label: '1. Khí hóa lỏng', answer: 'd' },
      { label: '2. Xăng', answer: 'e' },
      { label: '3. Dầu hỏa', answer: 'g' },
      { label: '4. Dầu diesel', answer: 'b' },
      { label: '5. Dầu bôi trơn', answer: 'a' },
      { label: '6. Nhựa đường', answer: 'c' }
    ];
    var B = [
      { v: 'a', t: 'Chất bôi trơn' },
      { v: 'b', t: 'Nhiên liệu cho động cơ diesel và các lò nung' },
      { v: 'c', t: 'Bề mặt đường nhựa, giấy dầu lợp mái' },
      { v: 'd', t: 'Nhiên liệu (sưởi ấm, bếp gas)' },
      { v: 'e', t: 'Nhiên liệu cho động cơ đốt trong (xe máy, ô tô,...)' },
      { v: 'g', t: 'Nhiên liệu cho động cơ phản lực' }
    ];
    var card = section('Câu 10', 'Nối sản phẩm chưng cất (cột A) với ứng dụng (cột B), theo Bảng 25.1.');
    var grid = el('div', 'match');
    var left = el('div', null);
    left.appendChild(el('p', 'colhead', 'Cột A (Phân đoạn)'));
    var bb = bankBlock('Cột B (Ứng dụng): kéo vào ô bên cạnh mỗi phân đoạn', 'stack');
    var g = newGroup('q10', bb.wrap, bb.bank, A.map(function (a) { return a.answer; }));
    B.forEach(function (b) { addChip(g, b.v, b.v + '. ' + b.t, 'wide'); });
    A.forEach(function (a) {
      var row = el('div', 'match-row');
      row.appendChild(el('div', 'alabel', a.label));
      var s = el('span', 'slot block');
      s.dataset.ph = 'Kéo ứng dụng vào đây';
      addSlot(g, s);
      row.appendChild(s);
      left.appendChild(row);
    });
    grid.appendChild(left);
    grid.appendChild(bb.wrap);
    card.appendChild(grid);
    actions(g, card);
    app.appendChild(card);
    fillBank(g);
  })();

  // Câu 11
  (function () {
    var paras = [
      ['Khí thiên nhiên được khai thác bằng cách ', 0, ' xuống mỏ khí, khí sẽ ', 1, ' do áp suất ở mỏ khí lớn hơn ', 2, '.'],
      ['Sau đó, khí được vận chuyển đến ', 3, ' để xử lí đạt chất lượng mong muốn trước khi phân phối đến các điểm tiêu thụ.']
    ];
    var answers = ['khoan', 'tự phun lên', 'áp suất khí quyển', 'nhà máy'];
    var card = section('Câu 11', 'Điền từ còn thiếu vào chỗ trống sau.');
    card.appendChild(el('p', 'q-sub', 'Từ gợi ý: khoan · áp suất khí quyển · nhà máy · tự phun lên'));
    var bb = bankBlock('Kéo từ vào chỗ trống', '');
    var g = newGroup('q11', bb.wrap, bb.bank, answers);
    answers.forEach(function (w) { addChip(g, w, w, ''); });
    card.appendChild(bb.wrap);
    var fill = el('div', 'fill');
    var slotsByIndex = [];
    paras.forEach(function (parts) {
      var p = el('p', null);
      parts.forEach(function (part) {
        if (typeof part === 'string') {
          p.appendChild(document.createTextNode(part));
        } else {
          var s = el('span', 'slot');
          slotsByIndex[part] = s;
          p.appendChild(s);
        }
      });
      fill.appendChild(p);
    });
    slotsByIndex.forEach(function (s) { addSlot(g, s); });
    card.appendChild(fill);
    actions(g, card);
    app.appendChild(card);
    fillBank(g);
  })();

  /* ---------- chạm (không kéo) ---------- */
  function tap(c) {
    if (c.classList.contains('locked')) return;
    if (inSlot(c)) {
      if (selected && selected !== c && selected.dataset.group === c.dataset.group) {
        place(selected, c.parentElement);
        return;
      }
      toBank(c);
      clearRes(groups[c.dataset.group]);
      return;
    }
    if (selected === c) deselect(); else select(c);
  }

  /* ---------- kéo thả bằng pointer events ---------- */
  function clearOver() {
    Array.prototype.forEach.call(document.querySelectorAll('#s3 .over'), function (n) { n.classList.remove('over'); });
  }
  function targetAt(x, y, gid) {
    var e = document.elementFromPoint(x, y);
    if (!e) return null;
    var s = e.closest('.slot');
    if (s && s.dataset.group === gid) return s;
    var bw = e.closest('.bank-wrap');
    if (bw && bw.dataset.group === gid) return bw;
    return null;
  }
  function autoScroll() {
    if (!drag || !drag.ghost) return;
    if (drag.y < 80) window.scrollBy(0, -14);
    else if (drag.y > window.innerHeight - 80) window.scrollBy(0, 14);
    window.requestAnimationFrame(autoScroll);
  }

  document.addEventListener('pointerdown', function (e) {
    if (drag) return;
    var c = e.target.closest && e.target.closest('#s3 .chip');
    if (!c || c.classList.contains('ghost') || c.classList.contains('locked')) return;
    if (e.pointerType === 'mouse' && e.button !== 0) return;
    drag = { chip: c, pid: e.pointerId, sx: e.clientX, sy: e.clientY, x: e.clientX, y: e.clientY, ghost: null, offX: 0, offY: 0 };
    try { c.setPointerCapture(e.pointerId); } catch (err) {}
  });

  document.addEventListener('pointermove', function (e) {
    if (!drag || e.pointerId !== drag.pid) return;
    drag.x = e.clientX; drag.y = e.clientY;
    if (!drag.ghost && Math.hypot(e.clientX - drag.sx, e.clientY - drag.sy) > 6) {
      var r = drag.chip.getBoundingClientRect();
      var gh = drag.chip.cloneNode(true);
      gh.classList.remove('selected', 'dragging', 'locked');
      gh.classList.add('ghost');
      gh.style.width = r.width + 'px';
      document.getElementById('s3').appendChild(gh);
      drag.ghost = gh;
      drag.offX = drag.sx - r.left;
      drag.offY = drag.sy - r.top;
      drag.chip.classList.add('dragging');
      deselect();
      window.requestAnimationFrame(autoScroll);
    }
    if (drag.ghost) {
      drag.ghost.style.left = (e.clientX - drag.offX) + 'px';
      drag.ghost.style.top = (e.clientY - drag.offY) + 'px';
      clearOver();
      var t = targetAt(e.clientX, e.clientY, drag.chip.dataset.group);
      if (t) t.classList.add('over');
    }
  });

  function endDrag(e, cancelled) {
    if (!drag || e.pointerId !== drag.pid) return;
    var d = drag;
    drag = null;
    clearOver();
    if (d.ghost) {
      d.ghost.remove();
      d.chip.classList.remove('dragging');
      if (cancelled) return;
      var t = targetAt(e.clientX, e.clientY, d.chip.dataset.group);
      if (t && t.classList.contains('slot')) {
        place(d.chip, t);
      } else if (inSlot(d.chip)) {
        toBank(d.chip);
        clearRes(groups[d.chip.dataset.group]);
      }
    } else if (!cancelled) {
      tap(d.chip);
    }
  }
  document.addEventListener('pointerup', function (e) { endDrag(e, false); });
  document.addEventListener('pointercancel', function (e) { endDrag(e, true); });

  /* ---------- nút chung ---------- */
  var summary = document.getElementById('summary');
  document.getElementById('btnAll').addEventListener('click', function () {
    var names = { q8: 'Câu 8', q10: 'Câu 10', q11: 'Câu 11' };
    var total = 0;
    var ul = el('ul', null);
    order.forEach(function (id) {
      var g = groups[id];
      var ok = checkGroup(g);
      total += ok;
      ul.appendChild(el('li', null, names[id] + ': ' + ok + '/' + g.slots.length));
    });
    summary.innerHTML = '';
    var head = el('strong', null, 'Kết quả: ' + total + '/' + TOTAL);
    summary.appendChild(head);
    summary.appendChild(ul);
    var pct = total / TOTAL;
    var msg = pct === 1 ? 'Xuất sắc! Bạn làm đúng tất cả các câu tự chấm.' :
              pct >= 0.7 ? 'Khá tốt! Sửa các ô màu đỏ rồi bấm Kiểm tra tất cả lần nữa.' :
              'Cố lên! Đọc lại mục 2 SGK trang 115 và Bảng 25.1 rồi thử lại.';
    summary.appendChild(el('p', null, msg + ' Câu 9 là câu tự luận, hãy tự đối chiếu với đáp án mẫu.'));
    summary.className = 'summary show' + (pct === 1 ? ' good' : '');
  });
  document.getElementById('btnResetAll').addEventListener('click', function () {
    order.forEach(function (id) { resetGroup(groups[id]); });
    q9.ta.value = '';
    q9.model.classList.remove('show');
    summary.className = 'summary';
    summary.innerHTML = '';
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });

  updateScore();
})();

</script>
<script>

const BAR='<div class="bar"><button class="btn" data-act="check">✅ Kiểm tra</button><button class="btn alt" data-act="reset">🔄 Làm lại</button><button class="btn alt" data-act="reveal">💡 Xem đáp án</button><span class="msg"></span></div>';
document.querySelectorAll('#p45 .q').forEach(q=>q.insertAdjacentHTML('beforeend',BAR));
const norm=s=>(s||'').toLowerCase().replace(/\s+/g,' ').trim();
const isP=el=>el.classList.contains('pills'),isS=el=>el.classList.contains('slot');
const val=el=>isP(el)?(el.querySelector('.on')||{}).textContent||'':isS(el)?((el.querySelector('.chip')||{dataset:{}}).dataset.v||''):el.value;
const answers=el=>el.dataset.ans.split('|');
function place(slot,chip){
  const bank=chip.closest('.q').querySelector('.bank'),old=slot.querySelector('.chip');
  if(old&&old!==chip)bank.appendChild(old);
  slot.appendChild(chip);chip.classList.remove('sel');slot.classList.remove('ok','bad');
}
function setv(el,v){
  if(isP(el))[...el.children].forEach(b=>b.classList.toggle('on',b.textContent===v));
  else if(isS(el)){const c=el.closest('.q').querySelector('.chip[data-v="'+v+'"]');if(c)place(el,c)}
  else el.value=v;
}
function correct(el){
  const v=norm(val(el));if(!v)return false;
  const a=answers(el).map(norm);
  return el.tagName==='INPUT'?a.some(x=>v.includes(x)):a.includes(v);
}
const clearMarks=q=>q.querySelectorAll('.ok,.bad').forEach(e=>e.classList.remove('ok','bad'));
/* kéo thả */
let drag=null;
document.addEventListener('dragstart',e=>{drag=e.target.closest&&e.target.closest('#p45 .chip');if(drag)e.dataTransfer.setData('text/plain',drag.dataset.v)});
document.addEventListener('dragover',e=>{const t=e.target.closest&&e.target.closest('.slot,.bank');if(t&&drag){e.preventDefault();t.classList.add('over')}});
document.addEventListener('dragleave',e=>{const t=e.target.closest&&e.target.closest('.slot,.bank');if(t)t.classList.remove('over')});
document.addEventListener('drop',e=>{
  const t=e.target.closest&&e.target.closest('.slot,.bank');if(!t||!drag)return;
  e.preventDefault();t.classList.remove('over');
  if(drag.closest('.q')!==t.closest('.q'))return;
  if(isS(t))place(t,drag);else{t.appendChild(drag);}
});
document.addEventListener('dragend',()=>{drag=null;document.querySelectorAll('.over').forEach(x=>x.classList.remove('over'))});
/* bấm */
document.addEventListener('click',e=>{
  if(e.target.closest('#s3,#p12'))return;
  const sel=document.querySelector('#p45 .chip.sel');
  const slot=e.target.closest('.slot');
  if(slot&&sel&&sel.closest('.q')===slot.closest('.q')){place(slot,sel);return}
  const chip=e.target.closest('.chip');
  if(chip){
    if(isS(chip.parentNode)){chip.parentNode.classList.remove('ok','bad');chip.closest('.q').querySelector('.bank').appendChild(chip)}
    else{const was=chip.classList.contains('sel');document.querySelectorAll('.chip.sel').forEach(c=>c.classList.remove('sel'));if(!was)chip.classList.add('sel')}
    return;
  }
  const bank=e.target.closest('.bank');
  if(bank&&sel){bank.appendChild(sel);sel.classList.remove('sel');return}
  const p=e.target.closest('.pills button');
  if(p){const g=p.parentNode;[...g.children].forEach(b=>b.classList.remove('on'));p.classList.add('on');g.classList.remove('ok','bad');return}
  const t=e.target.closest('.tab');
  if(t){document.querySelectorAll('.tab').forEach(x=>x.classList.toggle('on',x===t));
    document.querySelectorAll('.sheet,#s3').forEach(s=>s.classList.toggle('active',s.id===t.dataset.go));document.body.classList.toggle('on3',t.dataset.go==='s3');document.body.classList.toggle('on12',/^s[12]$/.test(t.dataset.go));window.scrollTo(0,0);return}
  const b=e.target.closest('[data-act]');if(!b)return;
  const q=b.closest('.q'),msg=q.querySelector('.msg'),items=[...q.querySelectorAll('[data-ans]')];
  if(b.dataset.act==='check'){
    clearMarks(q);
    const all=[...q.querySelectorAll('[data-ans],[data-empty]')];
    if(!all.length){msg.textContent='Câu tự luận – bấm “Xem đáp án” để so sánh nhé ✍️';return}
    const res=new Map();
    all.forEach(el=>{
      const empty=el.dataset.empty!==undefined;
      const ok=empty?!norm(el.value):correct(el);
      res.set(el,ok);
      if(!(empty&&ok))el.classList.add(ok?'ok':'bad');
    });
    const units=[...q.querySelectorAll('[data-unit]')];
    let n,t;
    if(units.length){t=units.length;n=units.filter(u=>[...u.querySelectorAll('[data-ans],[data-empty]')].every(x=>res.get(x))).length}
    else{t=all.length;n=all.filter(x=>res.get(x)).length}
    msg.textContent=n===t?`🎉 Chính xác ${n}/${t}!`:`Đúng ${n}/${t} – thử lại nhé 💪`;
  }
  if(b.dataset.act==='reveal'){
    clearMarks(q);
    q.querySelectorAll('[data-empty]').forEach(el=>{el.value=''});items.forEach(el=>setv(el,answers(el)[0]));
    q.querySelectorAll('[data-hint]').forEach(el=>{if(!el.value.trim()){el.value=el.dataset.hint;el.classList.add('hinted')}});
    q.classList.add('show');
    msg.textContent='Đây là gợi ý, em hãy giải thích lại bằng lời của mình nhé ✨';
  }
  if(b.dataset.act==='reset'){
    clearMarks(q);
    q.querySelectorAll('.pills .on').forEach(x=>x.classList.remove('on'));
    q.querySelectorAll('select,textarea,input').forEach(x=>{x.value='';x.classList.remove('hinted')});
    const bank=q.querySelector('.bank');
    q.querySelectorAll('.chip').forEach(c=>{c.classList.remove('sel');bank.appendChild(c)});
    q.classList.remove('show');msg.textContent='';
  }
});
document.addEventListener('input',e=>{e.target.classList.remove('hinted','ok','bad')});

</script>
